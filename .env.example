# ---------------------------------------------------------------------------
# Amaravati Land Allotment Portal - environment
# Copy to .env (root) and to server/.env before running.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Default: SQLite, zero infrastructure required.
DATABASE_URL="file:./dev.db"

# Postgres (docker compose) - run `npm run use:postgres` first, then:
# DATABASE_URL="postgresql://apcrda:apcrda@localhost:5432/amaravati?schema=public"

# --- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# «CONFIRM» Replace both secrets with long random strings before production.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="30m"          # session timeout for the access token
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
MAX_FAILED_LOGINS=5             # lockout threshold
LOCKOUT_MINUTES=15

# --- Storage --------------------------------------------------------------
# Local disk for the demo; swap STORAGE_DRIVER to "s3" once configured.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# --- Mail (demo logs to console) -----------------------------------------
MAIL_DRIVER=console
MAIL_FROM="APCRDA Portal <no-reply@apcrda.demo>"

# --- Frontend -------------------------------------------------------------
# Shows the quick-fill demo login buttons on the sign-in screen. Set false for production.
VITE_SHOW_DEMO_LOGINS=true

# Where the browser should send /api calls. Leave EMPTY for same-origin, which
# is right for local development (the Vite proxy) and for the Netlify deploy
# (the /api redirect). Only set this when the API is hosted on another domain,
# e.g. VITE_API_URL=https://apcrda-api.onrender.com
VITE_API_URL=
